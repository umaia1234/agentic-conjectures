import Mathlib

/-!
# ETP Problem 8.1 — does Equation 677 imply Equation 255 in every finite magma?

Upstream source: `FormalConjectures/Other/EquationalTheories_677_255.lean` in
google-deepmind/formal-conjectures at commit
`c094b979118b89adb77cf5f8d923ac9dd2e51b1d`, theorem
`Finite.Equation677_implies_Equation255` (tagged `research open`); snapshot in
`problems/etp-677-255-finite/upstream/`.  The problem is Problem 8.1 of
Tao et al., *The Equational Theories Project* (arXiv:2512.07087).

`Magma`, the `◇` notation, `Equation255` and `Equation677` are copied term for
term from the upstream file, and `statement` is the upstream proposition.  The
only differences are bookkeeping: the namespace is
`AgenticConjectures.Etp677Implies255Finite` instead of
`EquationalTheories_677_255`, the upstream file's `module`/`public import`/
`@[expose] public section` headers and its `@[category ...]`/`AMS` attributes
are dropped (they are FormalConjectures infrastructure), and the open theorem
becomes `def statement : Prop`.  The other upstream declarations are solved
side results and are not restated.

This module does **not** resolve the problem.  It proves, sorry-free:

* the finite-magma facts that justify every clause of the SAT encoding and
  every propagation rule of the search programs in the problem directory
  (bijective left translations, fixer uniqueness, the two inverse forms of
  E677, and three consequences of E255 failing at a point);
* the reduction used by those searches: a finite countermodel yields a finite
  countermodel of no larger cardinality that is generated by a single element
  at which E255 fails (`exists_generated_countermodel`);
* the translation-invariant ansatz `x ◇ y = x * f (x⁻¹ * y)` on a finite group:
  E677 is one functional equation for `f` (`tinv_eq677_iff`), E255 holds iff
  `f` has a fixed point (`tinv_eq255_iff`), a fixed-point-free solution
  refutes `statement` (`not_statement_of_tinv`), and the extra CNF clauses and
  the automorphism symmetry breaking of the group search are sound
  (`tinv_cnf_constraints`, `tinv_conj_solution`, `tinv_conj_fixed_iff`).

The certified search bound itself (no countermodel with at most `N` elements,
see the problem README) rests on DRAT certificates checked by `drat-trim`, not
on Lean; `noCountermodelUpTo` only records the exact proposition it certifies.
Likewise the negative translation-invariant searches are SAT-solver results,
not Lean theorems.
-/

namespace AgenticConjectures.Etp677Implies255Finite

class Magma (α : Type) where
  op : α → α → α

infix:65 " ◇ " => Magma.op

abbrev Equation255 (G: Type) [Magma G] := ∀ x : G, x = ((x ◇ x) ◇ x) ◇ x

abbrev Equation677 (G: Type) [Magma G] := ∀ x y : G, x = y ◇ (x ◇ ((y ◇ x) ◇ y))

/-- **Equational Theories, Problem 8.1** (upstream
`Finite.Equation677_implies_Equation255`): every finite magma satisfying
Equation 677 satisfies Equation 255. -/
def statement : Prop :=
  ∀ (G : Type) (_ : Magma G), Finite G → Equation677 G → Equation255 G

/-- The proposition certified by the exhaustive searches for a bound `N`:
no magma with at most `N` elements satisfies Equation 677 but not 255. -/
def noCountermodelUpTo (N : ℕ) : Prop :=
  ∀ (G : Type) (_ : Magma G), Finite G → Nat.card G ≤ N → Equation677 G → Equation255 G

theorem statement_iff_forall_noCountermodelUpTo :
    statement ↔ ∀ N, noCountermodelUpTo N :=
  ⟨fun h _ G _ hG _ h677 => h G _ hG h677,
    fun h G _ hG h677 => h (Nat.card G) G _ hG le_rfl h677⟩

section Basic

variable {G : Type} [Magma G]

/-- E677 makes every left translation `L_y` surjective, with
`L_y⁻¹ x = x ◇ ((y ◇ x) ◇ y)`. -/
theorem leftMul_surjective (h : Equation677 G) (y : G) :
    Function.Surjective (fun x => y ◇ x) :=
  fun x => ⟨x ◇ ((y ◇ x) ◇ y), (h x y).symm⟩

variable [Finite G]

/-- In a finite E677 magma every left translation is injective. -/
theorem leftMul_injective (h : Equation677 G) (y : G) :
    Function.Injective (fun x => y ◇ x) :=
  Finite.injective_iff_surjective.mpr (leftMul_surjective h y)

/-- In a finite E677 magma every left translation is a bijection (each row of
the multiplication table is a permutation). -/
theorem leftMul_bijective (h : Equation677 G) (y : G) :
    Function.Bijective (fun x => y ◇ x) :=
  ⟨leftMul_injective h y, leftMul_surjective h y⟩

theorem left_cancel (h : Equation677 G) (y : G) {a b : G} (hab : y ◇ a = y ◇ b) :
    a = b :=
  leftMul_injective h y hab

/-- Inverse form of E677: if `y ◇ c = x` then `x ◇ ((y ◇ x) ◇ y) = c`. -/
theorem inv_form (h : Equation677 G) {x y c : G} (hc : y ◇ c = x) :
    x ◇ ((y ◇ x) ◇ y) = c :=
  left_cancel h y ((h x y).symm.trans hc.symm)

/-- Second inverse form: if `y ◇ c = x` and `x ◇ b = c` then `(y ◇ x) ◇ y = b`. -/
theorem inv_form₂ (h : Equation677 G) {x y b c : G} (hc : y ◇ c = x) (hb : x ◇ b = c) :
    (y ◇ x) ◇ y = b :=
  left_cancel h x ((inv_form h hc).trans hb.symm)

/-- Backward recurrence (Lemma 13.1(iii) of the ETP blueprint). -/
theorem backward_recurrence (h : Equation677 G) (x y : G) :
    x = (y ◇ x) ◇ ((y ◇ (y ◇ x)) ◇ y) :=
  left_cancel h y (h (y ◇ x) y)

/-- Fixer uniqueness (Lemma 13.1(ii)): if `y ◇ x = x` then `y = (x ◇ x) ◇ x`. -/
theorem fixer_unique (h : Equation677 G) {x y : G} (hfix : y ◇ x = x) :
    y = (x ◇ x) ◇ x := by
  have hinv : y ◇ (x ◇ (x ◇ y)) = x := by
    have := (h x y).symm
    rwa [hfix] at this
  have hxy : x = x ◇ (x ◇ y) := left_cancel h y (by rw [hfix, hinv])
  exact left_cancel h x (left_cancel h x (hxy.symm.trans (h x x)))

/-- E255 holds at `x` iff some `y` fixes `x` from the left (Lemma 13.2). -/
theorem eq255_at_iff_exists_fixer (h : Equation677 G) (x : G) :
    x = ((x ◇ x) ◇ x) ◇ x ↔ ∃ y, y ◇ x = x := by
  constructor
  · intro hx
    exact ⟨(x ◇ x) ◇ x, hx.symm⟩
  · rintro ⟨y, hy⟩
    rw [← fixer_unique h hy]
    exact hy.symm

/-- If E255 fails at `x`, the column of `x` avoids `x`. -/
theorem fixer_free_of_not255 (h : Equation677 G) {x : G}
    (hx : ¬ x = ((x ◇ x) ◇ x) ◇ x) (y : G) : y ◇ x ≠ x :=
  fun hy => hx ((eq255_at_iff_exists_fixer h x).2 ⟨y, hy⟩)

/-- If E255 fails at `x`, then `x ◇ (z ◇ x) ≠ z` for every `z`
(Lemma 13.2(v)). -/
theorem ne_of_not255_v (h : Equation677 G) {x : G}
    (hx : ¬ x = ((x ◇ x) ◇ x) ◇ x) (z : G) : x ◇ (z ◇ x) ≠ z := by
  intro hz
  apply fixer_free_of_not255 h hx (x ◇ z)
  exact left_cancel h z (left_cancel h x ((h z x).symm.trans hz.symm))

/-- If E255 fails at `x`, then `x ◇ (y ◇ y) ≠ y` for every `y`
(Lemma 13.2(vii)). -/
theorem ne_of_not255_vii (h : Equation677 G) {x : G}
    (hx : ¬ x = ((x ◇ x) ◇ x) ◇ x) (y : G) : x ◇ (y ◇ y) ≠ y := by
  intro hy
  have h1 : y = (x ◇ y) ◇ x :=
    left_cancel h y (left_cancel h x (hy.trans (h y x)))
  apply ne_of_not255_v h hx (x ◇ y)
  rw [← h1]

end Basic

section Generated

variable {G : Type} [Magma G]

/-- `S` is closed under `◇`. -/
def Closed (S : Set G) : Prop := ∀ a ∈ S, ∀ b ∈ S, a ◇ b ∈ S

/-- The submagma generated by `x`. -/
def gen (x : G) : Set G := ⋂₀ {S | x ∈ S ∧ Closed S}

theorem mem_gen_self (x : G) : x ∈ gen x :=
  Set.mem_sInter.2 fun _ hS => hS.1

theorem gen_closed (x : G) : Closed (gen x) := fun a ha b hb =>
  Set.mem_sInter.2 fun S hS =>
    hS.2 a (Set.mem_sInter.1 ha S hS) b (Set.mem_sInter.1 hb S hS)

theorem gen_subset {x : G} {S : Set G} (hx : x ∈ S) (hS : Closed S) : gen x ⊆ S :=
  Set.sInter_subset_of_mem ⟨hx, hS⟩

/-- The magma structure induced on a closed subset. -/
abbrev subMagma (S : Set G) (hS : Closed S) : Magma S :=
  ⟨fun a b => ⟨a.1 ◇ b.1, hS _ a.2 _ b.2⟩⟩

/-- Reduction used by the searches: a finite countermodel with E255 failing at
`x` yields a finite countermodel, no larger, generated by one element at which
E255 fails (namely the submagma generated by `x`). -/
theorem exists_generated_countermodel [Finite G] (h : Equation677 G) {x : G}
    (hx : ¬ x = ((x ◇ x) ◇ x) ◇ x) :
    ∃ (H : Type) (_ : Magma H) (_ : Finite H) (g : H),
      Nat.card H ≤ Nat.card G ∧ Equation677 H ∧ ¬ g = ((g ◇ g) ◇ g) ◇ g ∧
      ∀ U : Set H, g ∈ U → (∀ a ∈ U, ∀ b ∈ U, a ◇ b ∈ U) → U = Set.univ := by
  letI inst : Magma (gen x) := subMagma (gen x) (gen_closed x)
  refine ⟨gen x, inst, inferInstance, ⟨x, mem_gen_self x⟩,
    Finite.card_subtype_le _, fun a b => Subtype.ext (h a.1 b.1),
    fun he => hx (congrArg Subtype.val he), ?_⟩
  intro U hg hU
  let V : Set G := {a | ∃ ha : a ∈ gen x, (⟨a, ha⟩ : gen x) ∈ U}
  have hV : Closed V := by
    rintro a ⟨ha, haU⟩ b ⟨hb, hbU⟩
    exact ⟨gen_closed x a ha b hb, hU _ haU _ hbU⟩
  have hxV : x ∈ V := ⟨mem_gen_self x, hg⟩
  refine Set.eq_univ_of_forall fun s => ?_
  obtain ⟨_, hs⟩ := gen_subset hxV hV s.2
  exact hs

/-- A countermodel to `statement`, if any, can be taken generated by a single
element at which E255 fails. -/
theorem not_statement_iff :
    ¬ statement ↔ ∃ (H : Type) (_ : Magma H) (_ : Finite H) (g : H),
      Equation677 H ∧ ¬ g = ((g ◇ g) ◇ g) ◇ g ∧
      ∀ U : Set H, g ∈ U → (∀ a ∈ U, ∀ b ∈ U, a ◇ b ∈ U) → U = Set.univ := by
  constructor
  · intro hs
    simp only [statement, not_forall] at hs
    obtain ⟨G, inst, hG, h677, h255⟩ := hs
    obtain ⟨x, hx⟩ := h255
    obtain ⟨H, instH, hH, g, -, h677', hg, hgen⟩ := exists_generated_countermodel h677 hx
    exact ⟨H, instH, hH, g, h677', hg, hgen⟩
  · rintro ⟨H, instH, hH, g, h677, hg, -⟩ hs
    exact hg (hs H instH hH h677 g)

end Generated

section TranslationInvariant

variable {G : Type} [Group G] [Magma G] {f : G → G}

/-! A magma structure on a group `G` of the form `x ◇ y = x * f (x⁻¹ * y)` is
translation invariant: every left translation of `G` is a magma automorphism. -/

theorem tinv_translate (hop : ∀ x y : G, x ◇ y = x * f (x⁻¹ * y)) (g a b : G) :
    (g * a) ◇ (g * b) = g * (a ◇ b) := by
  rw [hop, hop, mul_inv_rev, mul_assoc a⁻¹, inv_mul_cancel_left, mul_assoc]

/-- E677 for a translation-invariant magma reduces to one functional equation for `f`. -/
theorem tinv_eq677_iff (hop : ∀ x y : G, x ◇ y = x * f (x⁻¹ * y)) :
    Equation677 G ↔ ∀ x : G, x = f (x * f (x⁻¹ * (f x * f (f x)⁻¹))) := by
  have T1 : ∀ g b : G, g ◇ (g * b) = g * ((1 : G) ◇ b) := fun g b => by
    simpa using tinv_translate hop g 1 b
  have T2 : ∀ g a : G, (g * a) ◇ g = g * (a ◇ (1 : G)) := fun g a => by
    simpa using tinv_translate hop g a 1
  have key : ∀ x : G, (1 : G) ◇ (x ◇ (((1 : G) ◇ x) ◇ 1)) =
      f (x * f (x⁻¹ * (f x * f (f x)⁻¹))) := fun x => by
    simp only [hop, one_mul, inv_one, mul_one]
  constructor
  · intro h x
    rw [← key]
    exact h x 1
  · intro h x y
    obtain ⟨a, rfl⟩ : ∃ a, x = y * a := ⟨y⁻¹ * x, (mul_inv_cancel_left y x).symm⟩
    rw [T1, T2, tinv_translate hop, T1, key]
    exact congrArg (y * ·) (h a)

/-- In a translation-invariant magma, `x` has a left fixer iff `f` has a fixed point. -/
theorem tinv_fixer_iff (hop : ∀ x y : G, x ◇ y = x * f (x⁻¹ * y)) (x : G) :
    (∃ y, y ◇ x = x) ↔ ∃ z, f z = z := by
  constructor
  · rintro ⟨y, hy⟩
    refine ⟨y⁻¹ * x, ?_⟩
    rw [hop] at hy
    calc f (y⁻¹ * x) = y⁻¹ * (y * f (y⁻¹ * x)) := (inv_mul_cancel_left y _).symm
      _ = y⁻¹ * x := by rw [hy]
  · rintro ⟨z, hz⟩
    refine ⟨x * z⁻¹, ?_⟩
    have hz' : (x * z⁻¹)⁻¹ * x = z := by
      rw [mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel, mul_one]
    rw [hop, hz', hz, mul_assoc, inv_mul_cancel, mul_one]

/-- A finite translation-invariant E677 magma satisfies E255 iff `f` has a fixed point. -/
theorem tinv_eq255_iff [Finite G] (hop : ∀ x y : G, x ◇ y = x * f (x⁻¹ * y))
    (h : Equation677 G) : Equation255 G ↔ ∃ z, f z = z := by
  constructor
  · intro h255
    exact (tinv_fixer_iff hop 1).1 ((eq255_at_iff_exists_fixer h 1).1 (h255 1))
  · intro hz x
    exact (eq255_at_iff_exists_fixer h x).2 ((tinv_fixer_iff hop x).2 hz)

end TranslationInvariant

section TranslationInvariantSearch

variable {G : Type} [Group G] [Finite G]

/-- A fixed-point-free solution `f` of the functional equation on a finite group refutes
`statement` (via the magma `x ◇ y = x * f (x⁻¹ * y)`). -/
theorem not_statement_of_tinv (f : G → G)
    (hf : ∀ x : G, x = f (x * f (x⁻¹ * (f x * f (f x)⁻¹)))) (hfix : ∀ z, f z ≠ z) :
    ¬ statement := by
  intro hs
  letI : Magma G := ⟨fun x y => x * f (x⁻¹ * y)⟩
  have hop : ∀ x y : G, x ◇ y = x * f (x⁻¹ * y) := fun _ _ => rfl
  have h677 := (tinv_eq677_iff hop).2 hf
  obtain ⟨z, hz⟩ := (tinv_eq255_iff hop h677).1 (hs G _ inferInstance h677)
  exact hfix z hz

/-- Soundness of the translation-invariant CNF (`tinv_cnf.py`): besides the functional
equation and the absence of fixed points, every such `f` is a bijection and satisfies the
two extra clause families (Lemma 13.2 (v) and (vii) at the identity). -/
theorem tinv_cnf_constraints (f : G → G)
    (hf : ∀ x : G, x = f (x * f (x⁻¹ * (f x * f (f x)⁻¹)))) (hfix : ∀ z, f z ≠ z) :
    Function.Bijective f ∧ (∀ z, f (z * f z⁻¹) ≠ z) ∧ (∀ y, f (y * f 1) ≠ y) := by
  letI : Magma G := ⟨fun x y => x * f (x⁻¹ * y)⟩
  have hop : ∀ x y : G, x ◇ y = x * f (x⁻¹ * y) := fun _ _ => rfl
  have h677 := (tinv_eq677_iff hop).2 hf
  have h1 : ∀ z : G, (1 : G) ◇ z = f z := fun z => by rw [hop, inv_one, one_mul, one_mul]
  have hnot : ¬ (1 : G) = (((1 : G) ◇ 1) ◇ 1) ◇ 1 := by
    intro h255
    obtain ⟨z, hz⟩ := (tinv_fixer_iff hop 1).1 ((eq255_at_iff_exists_fixer h677 1).1 h255)
    exact hfix z hz
  refine ⟨?_, fun z hz => ?_, fun y hy => ?_⟩
  · have hb := leftMul_bijective h677 (1 : G)
    have hfun : (fun x => (1 : G) ◇ x) = f := funext h1
    rwa [hfun] at hb
  · apply ne_of_not255_v h677 hnot z
    rw [h1, hop, mul_one]
    exact hz
  · apply ne_of_not255_vii h677 hnot y
    rw [h1, hop, inv_mul_cancel]
    exact hy

omit [Finite G] in
/-- Symmetry breaking in the translation-invariant search: conjugating a solution `f` of
the functional equation by a group automorphism `φ` gives a solution. -/
theorem tinv_conj_solution (φ : G ≃* G) (f : G → G)
    (hf : ∀ x : G, x = f (x * f (x⁻¹ * (f x * f (f x)⁻¹)))) :
    ∀ x : G, x = (φ ∘ f ∘ φ.symm) (x * (φ ∘ f ∘ φ.symm)
      (x⁻¹ * ((φ ∘ f ∘ φ.symm) x * (φ ∘ f ∘ φ.symm) ((φ ∘ f ∘ φ.symm) x)⁻¹))) := by
  intro x
  obtain ⟨X, rfl⟩ := φ.surjective x
  simp only [Function.comp, MulEquiv.symm_apply_apply, ← map_inv, ← map_mul]
  exact congrArg φ (hf X)

omit [Finite G] in
/-- The conjugate `φ ∘ f ∘ φ⁻¹` has a fixed point iff `f` has one. -/
theorem tinv_conj_fixed_iff (φ : G ≃* G) (f : G → G) :
    (∃ z, (φ ∘ f ∘ φ.symm) z = z) ↔ ∃ z, f z = z := by
  constructor
  · rintro ⟨z, hz⟩
    refine ⟨φ.symm z, φ.injective ?_⟩
    simpa [Function.comp] using hz
  · rintro ⟨z, hz⟩
    exact ⟨φ z, by simp [Function.comp, hz]⟩

end TranslationInvariantSearch

end AgenticConjectures.Etp677Implies255Finite
